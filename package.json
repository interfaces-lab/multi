{
  "name": "@honk/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "scripts"
    ]
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && node scripts/prepare-effect-tsgo.mjs",
    "dev": "turbo run dev --filter=@honk/desktop",
    "dev:app": "turbo run dev --filter=@honk/app",
    "dev:desktop": "turbo run dev --filter=@honk/desktop",
    "start:desktop": "turbo run start --filter=@honk/desktop",
    "start:mock-update-server": "bun scripts/mock-update-server.ts",
    "honk": "bun packages/cli/src/bin.ts",
    "check:mobile": "pnpm --filter @honk/ui check:tokens && pnpm --filter @honk/ui typecheck && pnpm --filter @honk/mobile typecheck && pnpm --dir packages/mobile exec expo install --check && pnpm --dir packages/mobile exec expo-doctor .",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@honk/desktop",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm run lint:design && oxlint --report-unused-disable-directives && pnpm run konsistent && pnpm run lint:css",
    "lint:design": "node tooling/scripts/product-design/lint.mjs",
    "lint:css": "stylelint \"packages/**/*.css\" --allow-empty-input",
    "konsistent": "konsistent check",
    "konsistent:ci": "konsistent check --format=github",
    "test": "turbo run test",
    "core": "pnpm --filter @honk/core",
    "test:desktop-smoke": "turbo run smoke-test --filter=@honk/desktop",
    "check:app-architecture": "node scripts/check-app-architecture.mjs",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "knip": "knip --include-entry-exports --no-progress --no-config-hints",
    "knip:production": "knip --production --include-entry-exports --no-progress --no-config-hints",
    "assets:brand:sync": "python3 assets/brand/scripts/sync-icons.py",
    "assets:brand:normalize": "python3 assets/brand/scripts/normalize-macos-icons.py",
    "dist:desktop:artifact": "turbo run package --filter=@honk/desktop",
    "dist:desktop:dmg": "turbo run package:mac --filter=@honk/desktop",
    "dist:desktop:dmg:arm64": "turbo run package:mac --filter=@honk/desktop -- --arm64",
    "dist:desktop:dmg:x64": "turbo run package:mac --filter=@honk/desktop -- --x64",
    "dist:desktop:linux": "turbo run package:linux --filter=@honk/desktop -- --x64",
    "release:bump": "bumpp --no-commit --no-tag --no-push packages/desktop/package.json packages/app/package.json",
    "release:smoke": "pnpm --filter=@honk/release-scripts run test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/*/dist-electron packages/*/out .turbo packages/*/.turbo",
    "sync:vscode-icons": "node scripts/sync-vscode-icons.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "11.1.0",
    "bun": "catalog:",
    "knip": "^6.26.0",
    "konsistent": "1.0.0-beta.5",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-plugin-react-doctor": "0.2.16",
    "oxlint-tsgolint": "^0.24.0",
    "react-doctor": "0.2.16",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "2.10.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vite": "^8.1.4"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "msw": {
    "workerDirectory": [
      "packages/app/public"
    ]
  }
}
