{
  "expo": {
    "name": "Honk",
    "slug": "honk-mobile",
    "scheme": "honk",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.interfacesco.honk.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Honk connects to your computer through Tailscale.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.interfacesco.honk.mobile",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Honk to scan a connection QR code.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "react-native-enriched-markdown"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a08ff9c-772d-4349-95a0-ed3124fe2b06"
      }
    },
    "owner": "nameisdaniel"
  }
}
