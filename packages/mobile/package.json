{
  "name": "@honk/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev:phone": "expo start --dev-client --host lan",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild -p ios --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@honk/core": "workspace:*",
    "@honk/ui": "workspace:*",
    "@legendapp/list": "3.3.3",
    "expo": "~57.0.11",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-enriched-markdown": "^0.7.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-streamdown": "0.2.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "remend": "1.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "expo-doctor": "1.20.0",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
